import { Button, CheckBox, ComboBox, Slider } from "std-widgets.slint";

component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: #cdd6f4;

    background: #181825;
    border-radius: 6px;
    border-width: 1px;
    border-color: #313244;
    height: 46px;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text { text: root.label; color: #a6adc8; font-size: 9.5px; font-weight: 600; }
        Text { text: root.value; color: root.accent; font-size: 13.5px; font-weight: 800; }
    }
}

component MetricBar inherits HorizontalLayout {
    in property <string> label;
    in property <string> text-val;
    in property <float> ratio; // [0.0, 1.0]
    in property <color> bar-color;

    spacing: 6px;
    height: 16px;

    Text {
        width: 68px;
        text: root.label;
        color: #a6adc8;
        font-size: 10px;
        vertical-alignment: center;
    }

    Rectangle {
        horizontal-stretch: 1;
        height: 8px;
        background: #313244;
        border-radius: 4px;
        clip: true;

        Rectangle {
            x: 0px;
            width: parent.width * Math.clamp(root.ratio, 0.0, 1.0);
            height: 100%;
            background: root.bar-color;
            border-radius: 4px;
        }
    }

    Text {
        width: 48px;
        text: root.text-val;
        color: #cdd6f4;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component LegendDot inherits HorizontalLayout {
    in property <color> dot-color;
    in property <color> ring-color: transparent;
    in property <string> label;

    spacing: 5px;
    alignment: center;

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.dot-color;
        border-width: root.ring-color == transparent ? 0px : 2px;
        border-color: root.ring-color;
    }

    Text {
        text: root.label;
        color: #cdd6f4;
        font-size: 10.5px;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "MACES-HiDAC 2D — Simulador Estocástico Multipiso de Evacuación e Incendios";
    min-width: 1340px;
    min-height: 800px;
    background: #1e1e2e;

    in property <image> canvas-frame;
    in property <image> chart-frame;
    in property <string> status-text: "Rutina Normal activa. Haz clic en el mapa o elige un Preset.";
    in property <[string]> floor-options: ["Grilla: Todos los Pisos", "Piso 0", "Piso 1", "Piso 2"];

    // KPIs Globales
    in property <int> total-agents: 180;
    in property <int> evacuated-agents: 0;
    in property <int> alerted-agents: 0;
    in property <int> fallen-agents: 0;
    in property <int> incapacitated-agents: 0;
    in property <string> sim-time-text: "0.0 s";
    in property <string> aset-rset-text: "Seg. / --";

    // Datos Visuales del Inspector de Agentes / Brigadistas
    in property <string> insp-title: "AGENTE #000 — Brigadista Entrenado";
    in property <string> insp-badge-role: "Adulto | Familia #1";
    in property <string> insp-badge-state: "Rutina Normal (Piso 0)";
    in property <color> insp-accent: #94e2d5;
    in property <float> insp-health-ratio: 1.0;
    in property <string> insp-health-text: "100%";
    in property <float> insp-panic-ratio: 0.1;
    in property <string> insp-panic-text: "1.0/10";
    in property <float> insp-speed-ratio: 0.5;
    in property <string> insp-speed-text: "1.2 m/s";
    in property <float> insp-rescue-ratio: 0.0;
    in property <string> insp-rescue-text: "0 resc.";

    // Controles interactivos y Checkboxes de Comportamiento
    in-out property <bool> is-running: false;
    in-out property <int> view-mode: 0;
    in-out property <int> active-tool: 0;
    in-out property <bool> show-graph: false;
    in-out property <bool> show-thermal: true;
    in-out property <bool> global-alarm: false;

    in-out property <bool> enable-wardens: true;
    in-out property <bool> enable-warden-line: true;
    in-out property <bool> enable-social: true;
    in-out property <bool> enable-helping: true;
    in-out property <bool> enable-panic-freeze: true;
    in-out property <bool> enable-comm: true;

    in-out property <float> population-slider: 180.0;
    in-out property <float> panic-slider: 15.0;
    in-out property <float> trained-slider: 12.0;

    callback canvas-clicked(float, float, float, float);
    callback request-redraw();
    callback toggle-running();
    callback update-parameters();
    callback change-population();
    callback reset-building();
    callback load-preset(int);
    callback next-warden();
    callback next-agent();

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;

        // COLUMNA IZQUIERDA: KPIs + Lienzo Multipiso en Grilla + Leyenda Visual de Agentes y Aros
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                KpiCard { label: "TIEMPO"; value: root.sim-time-text; accent: #89b4fa; }
                KpiCard { label: "EN ALERTA"; value: root.alerted-agents + " / " + root.total-agents; accent: #f9e2af; }
                KpiCard { label: "EVACUADOS"; value: root.evacuated-agents + " (" + Math.round(root.evacuated-agents * 100 / Math.max(1, root.total-agents)) + "%)"; accent: #a6e3a1; }
                KpiCard { label: "CAÍDOS"; value: root.fallen-agents; accent: #fab387; }
                KpiCard { label: "VÍCTIMAS (FED)"; value: root.incapacitated-agents; accent: #f38ba8; }
                KpiCard { label: "ASET / RSET"; value: root.aset-rset-text; accent: #cba6f7; }
            }

            Rectangle {
                vertical-stretch: 1;
                background: #181825;
                border-radius: 8px;
                border-width: 1px;
                border-color: #45475a;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.canvas-frame;
                    image-fit: fill;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.canvas-clicked(
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                            self.width / 1px,
                            self.height / 1px
                        );
                    }
                }
            }

            // LEYENDA VISUAL GRÁFICA DE AGENTES, AROS Y ESTADOS
            Rectangle {
                height: 54px;
                background: #181825;
                border-radius: 6px;
                border-width: 1px;
                border-color: #313244;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        LegendDot { dot-color: #94e2d5; ring-color: #ffffff; label: "Brigadista (Aro Blanco)"; }
                        LegendDot { dot-color: #89b4fa; label: "Adulto / Joven"; }
                        LegendDot { dot-color: #f9e2af; label: "Niño"; }
                        LegendDot { dot-color: #cba6f7; label: "Mayor / Mov. Reducida"; }
                        LegendDot { dot-color: #89b4fa; ring-color: #f9e2af; label: "Aro Amarillo: Alerta"; }
                        LegendDot { dot-color: #f38ba8; ring-color: #f38ba8; label: "Aro Rojo: En Shock / Pánico"; }
                        LegendDot { dot-color: #a6e3a1; ring-color: #a6e3a1; label: "Verde: Ayudando / Extintor"; }
                    }

                    Text {
                        text: root.status-text;
                        color: #a6e3a1;
                        font-size: 11.5px;
                        overflow: elide;
                    }
                }
            }
        }

        // PANEL LATERAL DERECHO: Controles Modulares + Inspector Visual + Curva Telemétrica
        Rectangle {
            width: 365px;
            background: #181825;
            border-radius: 8px;
            border-width: 1px;
            border-color: #313244;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: root.is-running ? "⏸ Pausar" : "▶ Iniciar (60 FPS)";
                        primary: true;
                        horizontal-stretch: 1;
                        clicked => { root.toggle-running(); }
                    }
                    Button {
                        text: "↺ Reiniciar";
                        horizontal-stretch: 1;
                        clicked => { root.reset-building(); }
                    }
                }

                ComboBox {
                    model: [
                        "Preset 1: Completo (Brigada + Familias)",
                        "Preset 2: Individualista (Sin Ayuda ni Brigada)",
                        "Preset 3: Brigadistas en Fila + Extintor",
                        "Preset 4: Pánico Masivo (80%) + Shock"
                    ];
                    current-index: 0;
                    selected => { root.load-preset(self.current-index); }
                }

                HorizontalLayout {
                    spacing: 6px;
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.floor-options;
                        current-index: 0;
                        selected => {
                            root.view-mode = self.current-index;
                            root.request-redraw();
                        }
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: ["Clic: Fuego", "Clic: Puerta", "Clic: Inspector"];
                        current-index: 0;
                        selected => { root.active-tool = self.current-index; }
                    }
                }

                Text {
                    text: "Aforo: " + Math.round(root.population-slider) + " pers.  |  Brigada: " + Math.round(root.trained-slider) + "%  |  Pánico: " + Math.round(root.panic-slider) + "%";
                    color: #cdd6f4;
                    font-size: 10.5px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 5px;
                    Slider {
                        minimum: 40.0;
                        maximum: 400.0;
                        value <=> root.population-slider;
                        released => { root.change-population(); }
                    }
                    Slider {
                        minimum: 0.0;
                        maximum: 50.0;
                        value <=> root.trained-slider;
                        changed => { root.update-parameters(); }
                    }
                    Slider {
                        minimum: 0.0;
                        maximum: 100.0;
                        value <=> root.panic-slider;
                        changed => { root.update-parameters(); }
                    }
                }

                // INTERRUPTORES OPCIONALES DE COMPORTAMIENTO (Grid 2 columnas)
                Rectangle {
                    background: #11111b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313244;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;

                        HorizontalLayout {
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Brigadistas Activos";
                                checked <=> root.enable-wardens;
                                toggled => { root.update-parameters(); }
                            }
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Fila tras Brigadista";
                                checked <=> root.enable-warden-line;
                                toggled => { root.update-parameters(); }
                            }
                        }

                        HorizontalLayout {
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Lazos Familiares";
                                checked <=> root.enable-social;
                                toggled => { root.update-parameters(); }
                            }
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Ayudar a Caídos";
                                checked <=> root.enable-helping;
                                toggled => { root.update-parameters(); }
                            }
                        }

                        HorizontalLayout {
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Shock por Pánico";
                                checked <=> root.enable-panic-freeze;
                                toggled => { root.update-parameters(); }
                            }
                            CheckBox {
                                horizontal-stretch: 1;
                                text: "Alarma Global";
                                checked <=> root.global-alarm;
                                toggled => {
                                    root.update-parameters();
                                    root.request-redraw();
                                }
                            }
                        }
                    }
                }

                // TARJETA GRÁFICA DEL INSPECTOR DE AGENTES Y BRIGADISTAS
                HorizontalLayout {
                    spacing: 4px;
                    alignment: space-between;
                    Text {
                        text: "INSPECTOR VISUAL EN VIVO";
                        color: #f9e2af;
                        font-size: 11px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "👮 Sig. Brigada";
                        clicked => { root.next-warden(); }
                    }
                    Button {
                        text: "👤 Sig. Agente";
                        clicked => { root.next-agent(); }
                    }
                }

                Rectangle {
                    background: #11111b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.insp-accent;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.insp-title;
                                color: root.insp-accent;
                                font-size: 11.5px;
                                font-weight: 800;
                            }
                            Text {
                                text: root.insp-badge-role;
                                color: #cdd6f4;
                                font-size: 10px;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            background: #1e1e2e;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.insp-badge-state;
                                    color: #a6e3a1;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        MetricBar {
                            label: "Salud (FED)";
                            ratio: root.insp-health-ratio;
                            text-val: root.insp-health-text;
                            bar-color: #a6e3a1;
                        }
                        MetricBar {
                            label: "Nivel Pánico";
                            ratio: root.insp-panic-ratio;
                            text-val: root.insp-panic-text;
                            bar-color: #f38ba8;
                        }
                        MetricBar {
                            label: "Vel. Media";
                            ratio: root.insp-speed-ratio;
                            text-val: root.insp-speed-text;
                            bar-color: #89b4fa;
                        }
                        MetricBar {
                            label: "Rescates";
                            ratio: root.insp-rescue-ratio;
                            text-val: root.insp-rescue-text;
                            bar-color: #f9e2af;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "TELEMETRÍA (0-100%)"; color: #cdd6f4; font-size: 10.5px; font-weight: 700; }
                    Text { text: "Verde: Evac | Azul: Alerta | Rojo: FED"; color: #a6adc8; font-size: 9.5px; }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 110px;
                    background: #11111b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #45475a;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.chart-frame;
                        image-fit: fill;
                    }
                }
            }
        }
    }
}
